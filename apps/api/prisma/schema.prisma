// Modelo de dados do chat-tess.
// Convenção: models em PascalCase, tabelas e colunas em snake_case.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Usuários e acesso ─────────────────────────────

enum UserRole {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  settings          UserSettings?
  creditAccount     CreditAccount?
  conversations     Conversation[]
  attachments       Attachment[]
  toolSettings      UserToolSetting[]
  toolCalls         ToolCall[]
  usageRecords      UsageRecord[]
  connectorAccounts ConnectorAccount[]
  mcpServers        McpServer[]
  activeTurns       ActiveTurn[]

  @@map("users")
}

/// Lista de permitidos: e-mail completo ("ana@empresa.com") ou domínio ("@empresa.com").
model AllowedEmail {
  id        String   @id @default(uuid()) @db.Uuid
  pattern   String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("allowed_emails")
}

model UserSettings {
  userId       String   @id @map("user_id") @db.Uuid
  systemPrompt String?  @map("system_prompt")
  model        String?
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─────────────────────────── Conversas e mensagens ───────────────────────────

model Conversation {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  title             String
  /// Tokens de entrada do último turno; é o gatilho da compactação.
  lastContextTokens Int      @default(0) @map("last_context_tokens")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  summaries    ConversationSummary[]
  attachments  Attachment[]
  toolCalls    ToolCall[]
  usageRecords UsageRecord[]
  activeTurn   ActiveTurn?

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  /// Posição da mensagem na conversa, começando em 1.
  sequence       Int
  role           MessageRole
  /// Lista de MessagePart (formato neutro definido em @chat-tess/shared).
  parts          Json
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@unique([conversationId, sequence])
  @@map("messages")
}

/// Resumo gerado pela compactação. Substitui, no contexto enviado ao LLM, as
/// mensagens até `coversUntilSequence`. As mensagens originais são preservadas.
model ConversationSummary {
  id                     String   @id @default(uuid()) @db.Uuid
  conversationId         String   @map("conversation_id") @db.Uuid
  content                String
  coversUntilSequence    Int      @map("covers_until_sequence")
  summarizedMessageCount Int      @map("summarized_message_count")
  createdAt              DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, coversUntilSequence(sort: Desc)])
  @@map("conversation_summaries")
}

model Attachment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  /// Preenchido quando o anexo é enviado em uma mensagem.
  messageId      String?  @map("message_id") @db.Uuid
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  /// Endereço no storage: "gs://bucket/chave" ou "file://caminho".
  storageUri     String   @map("storage_uri")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@map("attachments")
}

// ─────────────────────────────────── Tools ───────────────────────────────────

enum ToolSource {
  BUILT_IN
  CONNECTOR
  MCP
}

/// Catálogo das tools nativas e de conectores, sincronizado com o registro em
/// código na inicialização. Tools de MCP ficam em `McpServer.cachedTools`.
model Tool {
  name             String     @id
  description      String
  source           ToolSource
  inputSchema      Json       @map("input_schema")
  enabledByDefault Boolean    @default(true) @map("enabled_by_default")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@map("tools")
}

/// Preferência do usuário por tool. Sem chave estrangeira para `tools`: tools de
/// servidores MCP são descobertas em tempo de execução e não estão no catálogo.
model UserToolSetting {
  userId   String  @map("user_id") @db.Uuid
  toolName String  @map("tool_name")
  enabled  Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, toolName])
  @@map("user_tool_settings")
}

enum ToolCallStatus {
  SUCCEEDED
  FAILED
}

model ToolCall {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  /// Identificador da chamada dentro do turno, gerado pelo LLM ou pelo adapter.
  callId         String         @map("call_id")
  toolName       String         @map("tool_name")
  input          Json
  output         Json?
  status         ToolCallStatus
  errorMessage   String?        @map("error_message")
  durationMs     Int            @map("duration_ms")
  createdAt      DateTime       @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("tool_calls")
}

// ─────────────────────────── Consumo e créditos ──────────────────────────────

enum UsagePurpose {
  CHAT
  COMPACTION
  TOOL
}

/// Uma linha por chamada ao LLM.
model UsageRecord {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  conversationId String?      @map("conversation_id") @db.Uuid
  model          String
  purpose        UsagePurpose
  inputTokens    Int          @map("input_tokens")
  outputTokens   Int          @map("output_tokens")
  totalTokens    Int          @map("total_tokens")
  createdAt      DateTime     @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("usage_records")
}

/// Cap de tokens do usuário. `tokensUsed` é a soma dos `UsageRecord`, mantida
/// aqui para que a verificação de saldo não precise agregar o histórico.
model CreditAccount {
  userId     String   @id @map("user_id") @db.Uuid
  tokenLimit BigInt   @map("token_limit")
  tokensUsed BigInt   @default(0) @map("tokens_used")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_accounts")
}

// ───────────────────────────── Turnos em andamento ──────────────────────────────

/// Reserva de uma resposta em andamento: uma por conversa, poucas por usuário.
/// Removida ao fim do turno; reservas antigas são de instâncias que caíram.
model ActiveTurn {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  conversationId String   @unique @map("conversation_id") @db.Uuid
  startedAt      DateTime @default(now()) @map("started_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("active_turns")
}

// ───────────────────────────────── Auditoria ─────────────────────────────────

/// Registro imutável de um evento de domínio. Sem chave estrangeira para o
/// usuário: o registro precisa sobreviver à exclusão de quem o causou.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  payload     Json
  occurredAt  DateTime @map("occurred_at")
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([type, occurredAt(sort: Desc)])
  @@map("audit_events")
}

// ─────────────────────────── Conectores e MCP ────────────────────────────────

enum ConnectorProvider {
  GOOGLE_DRIVE
  GMAIL
}

model ConnectorAccount {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String            @map("user_id") @db.Uuid
  provider              ConnectorProvider
  accountEmail          String            @map("account_email")
  /// Refresh token do OAuth, cifrado com AES-256-GCM.
  encryptedRefreshToken String            @map("encrypted_refresh_token")
  scopes                String[]
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("connector_accounts")
}

model McpServer {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String
  url                 String
  /// Valor do cabeçalho Authorization, cifrado com AES-256-GCM.
  encryptedAuthHeader String?  @map("encrypted_auth_header")
  enabled             Boolean  @default(true)
  /// Última lista de tools obtida do servidor.
  cachedTools         Json     @default("[]") @map("cached_tools")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("mcp_servers")
}
