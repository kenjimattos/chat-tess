{
  "name": "chat-tess",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @chat-tess/api\" \"npm run dev -w @chat-tess/web\"",
    "build": "npm run build -w @chat-tess/web && npm run build -w @chat-tess/api",
    "start": "npm run start -w @chat-tess/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @chat-tess/api",
    "db:migrate": "npm run db:migrate -w @chat-tess/api",
    "e2e": "npm run test -w @chat-tess/e2e",
    "e2e:live": "npm run test:live -w @chat-tess/e2e",
    "load-test": "tsx e2e/load/concurrent-users.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
