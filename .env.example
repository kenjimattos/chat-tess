# Copie para .env e ajuste.
# Todas as variáveis são validadas em apps/api/src/infra/config/env.ts

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres. O padrão aponta para o banco do docker compose.
DATABASE_URL=postgresql://chat_tess:chat_tess@localhost:5433/chat_tess
# Conexões abertas por instância da API; o Cloud SQL db-f1-micro aceita poucas.
DATABASE_POOL_MAX=5

# Pasta com o build do frontend. Em produção a API também serve o site.
WEB_DIST_DIR=
# Endereço pelo qual o navegador acessa a aplicação (em desenvolvimento, o Vite).
PUBLIC_BASE_URL=http://localhost:5173

# Sessão. Gere o segredo com: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=168

# Login. "google" usa o OAuth do Google; "test" habilita POST /api/auth/test-login,
# usado pelos testes ponta a ponta e proibido em produção.
AUTH_MODE=google
# Cliente OAuth do tipo "Aplicativo da Web".
# Também lidas por infra/provision.sh para configurar o Cloud Run.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# E-mails ou domínios (@empresa.com) liberados, separados por vírgula.
ALLOWED_EMAILS=
# E-mails ou domínios que recebem o papel de administrador (auditoria completa e limites de uso).
ADMIN_EMAILS=

# LLM. "gemini" usa o Agent Platform com as credenciais padrão do Google Cloud
# (gcloud auth application-default login); "fake" responde de forma roteirizada,
# para testes, e é proibido em produção.
LLM_MODE=gemini
GCP_PROJECT_ID=
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Orçamento de contexto da conversa e fração dele que dispara a compactação do histórico.
# Menor que a janela do modelo (1M) de propósito: cada mensagem reenvia o contexto inteiro.
CONTEXT_TOKEN_LIMIT=100000
COMPACTION_THRESHOLD_RATIO=0.8
COMPACTION_KEEP_RECENT_MESSAGES=6
MAX_TOOL_ROUNDS=8
# Tools executando ao mesmo tempo numa rodada; as demais esperam a vez.
MAX_PARALLEL_TOOL_CALLS=3
# Respostas em andamento ao mesmo tempo por usuário, somando todas as conversas.
MAX_CONCURRENT_TURNS_PER_USER=3
# Rate limit por usuário, em requisições por minuto.
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_UPLOADS_PER_MINUTE=30
# Só para testes locais: deixa a tool web_scrape acessar localhost. Proibido em produção.
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false
# Cap vitalício de tokens de cada usuário novo (não renova); administradores ajustam por usuário.
DEFAULT_TOKEN_LIMIT=500000

# Anexos: "local" grava em disco (LOCAL_STORAGE_DIR); "gcs" usa o Cloud Storage.
FILE_STORAGE=local
LOCAL_STORAGE_DIR=.storage
GCS_BUCKET=
MAX_UPLOAD_MB=20
# Teto por usuário dos anexos ainda não enviados em mensagem, somando todas as conversas.
MAX_PENDING_ATTACHMENTS_MB=500
