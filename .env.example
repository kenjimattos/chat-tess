# Copie para .env e ajuste.
# Todas as variáveis são validadas em apps/api/src/shared/config/env.ts

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres. O padrão aponta para o banco do docker compose.
DATABASE_URL=postgresql://chat_tess:chat_tess@localhost:5433/chat_tess

# Pasta com o build do frontend. Em produção a API também serve o site.
WEB_DIST_DIR=
